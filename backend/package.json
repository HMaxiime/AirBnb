{
  "name": "airbnb-api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node node_modules/nodemon/bin/nodemon.js --exec 'node node_modules/tsx/dist/cli.mjs' src/index.ts",
    "build": "node node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "migrate": "node node_modules/prisma/build/index.js migrate deploy",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:migrate:prod": "node node_modules/prisma/build/index.js migrate deploy",
    "db:reset": "node node_modules/prisma/build/index.js migrate reset",
    "db:seed": "node node_modules/prisma/build/index.js db seed",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:push": "node node_modules/prisma/build/index.js db push",
    "db:status": "node node_modules/prisma/build/index.js migrate status",
    "db:fresh": "node node_modules/prisma/build/index.js migrate reset && node node_modules/prisma/build/index.js db seed",
    "postinstall": "node node_modules/prisma/build/index.js generate"
  },
  "prisma": {
    "seed": "node node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@langchain/core": "^1.1.45",
    "@langchain/groq": "^1.2.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/cors": "^2.8.19",
    "@types/morgan": "^1.9.10",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.4.0",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^8.0.7",
    "nodemon": "^3.1.14",
    "pg": "^8.20.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  }
}
